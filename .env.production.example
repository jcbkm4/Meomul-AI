# Public domains
APP_DOMAIN=meomul.com
API_DOMAIN=api.meomul.com
LETSENCRYPT_EMAIL=you@example.com

# Frontend public environment
NEXT_PUBLIC_GRAPHQL_URL=https://api.meomul.com/graphql
NEXT_PUBLIC_API_URL=https://api.meomul.com
NEXT_PUBLIC_CHAT_SOCKET_URL=https://api.meomul.com
NEXT_PUBLIC_SITE_URL=https://meomul.com
NEXT_PUBLIC_BUILD_ID=deploy-20260312

# API / batch environment
MONGO_PROD=
JWT_SECRET=
COOKIE_SECRET=
JWT_EXPIRES_IN=15m
FRONTEND_URL=https://meomul.com
SOCKET_CORS_ORIGINS=https://meomul.com,https://api.meomul.com
REDIS_SOCKET_ENABLED=false
BATCH_ALERT_WEBHOOK_URL=

# ── Index management ──────────────────────────────────────────
# Production runs with autoIndex disabled, so the batch worker builds MongoDB
# indexes at boot. Idempotent and additive; it never drops an index.
# Set to "false" only if you are running the sync manually.
RUN_INDEX_SYNC=true

# ── Error tracking (Sentry) ───────────────────────────────────
# All optional: with no DSN set, the SDKs stay inert and errors go to stdout only.
# Separate projects for API and web keep the issue streams readable.
SENTRY_DSN_API=
SENTRY_DSN_WEB=
# Browser DSN. Inlined into the JS bundle at BUILD time, so changing it needs a
# rebuild, not just a restart. A DSN is write-only and not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Performance tracing is billed per transaction; 0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=0

# ── SMS (REQUIRED) ────────────────────────────────────────────
# Password recovery sends a one-time code by SMS — members have no email address.
# The API refuses to start in production with SMS_PROVIDER=log, because reset codes
# would be written to stdout instead of delivered.
SMS_PROVIDER=solapi
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# ── Logging ───────────────────────────────────────────────────
# Both apps emit newline-delimited JSON in production, one line per request plus a
# structured line per GraphQL operation, correlated by x-request-id.
LOG_LEVEL=info
# Logs Mongo queries slower than the threshold. Useful once indexes are in place.
MONGO_SLOW_QUERY_LOG=false
