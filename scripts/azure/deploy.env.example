AZ_RESOURCE_GROUP=PersonalProjects
AZ_LOCATION=Korea Central
AZ_ACR_NAME=unityprodacr123
AZ_ENV_NAME=meomul-prod-env
AZ_API_APP_NAME=meomul-api
AZ_FRONTEND_APP_NAME=meomul-frontend
AZ_BATCH_APP_NAME=meomul-batch
AZ_IMAGE_TAG=release

# Optional
# AZ_SUBSCRIPTION_ID=<your-subscription-id>
# AZ_IMAGE_TAG_SUFFIX=20260312143000
# AZ_API_CPU=0.5
# AZ_API_MEMORY=1Gi
# AZ_API_MIN_REPLICAS=1
# AZ_API_MAX_REPLICAS=1
# AZ_FRONTEND_CPU=0.5
# AZ_FRONTEND_MEMORY=1Gi
# AZ_FRONTEND_MIN_REPLICAS=1
# AZ_FRONTEND_MAX_REPLICAS=2
# AZ_BATCH_CPU=0.25
# AZ_BATCH_MEMORY=0.5Gi
# BUILD_MODE=auto                                # auto | remote | local
# FRONTEND_URL=https://stay.meomul.com          # optional custom frontend domain
# BACKEND_URL=https://api.meomul.com            # optional custom API domain
# SOCKET_CORS_ORIGINS=https://stay.meomul.com   # defaults to FRONTEND_URL / derived frontend URL
# JWT_EXPIRES_IN=15m
# REDIS_URL=redis://<your-redis-host>:6379
# REDIS_SOCKET_ENABLED=false
# NEXT_PUBLIC_BUILD_ID=<git-sha-or-release-id>
# AZ_UPLOADS_STORAGE_NAME=meomuluploads
# AZ_UPLOADS_ACCOUNT_NAME=<storage-account-name>
# AZ_UPLOADS_ACCOUNT_KEY=<storage-account-key>
# AZ_UPLOADS_SHARE_NAME=meomul-uploads
# AZ_UPLOADS_MOUNT_PATH=/app/uploads
# AZ_API_REVISION=meomul-api--<revision-id>
# AZ_FRONTEND_REVISION=meomul-frontend--<revision-id>
# AZ_BATCH_REVISION=meomul-batch--<revision-id>
# TIMEOUT_SECONDS=20
# AUTO_ROLLBACK_ON_FAIL=true

# Required app secrets
MONGO_PROD=
JWT_SECRET=
COOKIE_SECRET=
